<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: the event tap and paste-into-any-app need Accessibility, which the sandbox forbids. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Calendars under hardened runtime (EventKit events). Reminders has no hardened-runtime key; TCC and the usage string gate it. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
