          "when",
          "attendees"
        ],
        "type" : "object"
      },
      "name" : "propose_calendar_invite",
      "risk" : "connected_draft"
    },
    {
      "description" : "Do nothing: the utterance is dictation, a mention, chit-chat, or a request to refuse (sensitive, unsupported, ambiguous or more than one action).",
      "input_schema" : {
        "additionalProperties" : false,
        "properties" : {
          "reason" : {
            "description" : "Why no tool runs",
            "enum" : [
              "not_a_command",
              "needs_clarification",
              "multi_intent",
              "sensitive_content",
              "unsupported"
            ],
            "type" : "string",
            "x-match" : "enum"
          }
        },
        "required" : [
          "reason"
        ],
        "type" : "object"
      },
      "name" : "no_action",
      "risk" : "none"
