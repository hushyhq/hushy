// The docs site: static files only, served by Cloudflare Workers at docs.tryhushy.com.
// Deploy: npm run deploy (needs a Cloudflare login with access to the tryhushy.com zone).
{
  "name": "hushy-docs",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "docs.tryhushy.com", "custom_domain": true }]
}
